# prod  → NEXT_PUBLIC_API_PREFIX=,       NEXT_PUBLIC_DOMAIN=.com
# stage → NEXT_PUBLIC_API_PREFIX=stage-, NEXT_PUBLIC_DOMAIN=.net
# local → NEXT_PUBLIC_API_PREFIX=local-, NEXT_PUBLIC_DOMAIN=.net
NEXT_PUBLIC_API_PREFIX=local-
NEXT_PUBLIC_ENVIRONMENT=local
NEXT_PUBLIC_DOMAIN=.net

NEXT_PUBLIC_APP_NAME=TA & Per-Diem

# Login with 10 Minute School (public client ID — safe in the browser)
NEXT_PUBLIC_TENMS_CLIENT_ID=tenms_xxxxxxxxxxxxxxxx
NEXT_PUBLIC_TENMS_SOURCE_PLATFORM=admin
# Optional: pin the OAuth redirect URI. Defaults to the current origin.
# NEXT_PUBLIC_TENMS_REDIRECT_URI=https://your-app.vercel.app

GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
SPREADSHEET_ID=your_spreadsheet_id

# Local development only. Never set this in production — SSO is the front door.
# ALLOW_PASSWORD_LOGIN=true

# Shared Drive (or a folder inside one) that claim documents are uploaded into.
# It MUST be a Shared Drive: a service account has no storage quota of its own,
# so a personal My Drive folder is rejected however it is shared.
DRIVE_FOLDER_ID=your_shared_drive_id
# Largest single file, in MB. The bytes go straight from the browser to Google,
# so this is not limited by the serverless request size.
# MAX_UPLOAD_MB=50
# Uploaded files are made readable by anyone with the link, so approvers — who
# are not members of the Shared Drive — can open them. Set false if the Drive
# is shared with everyone who needs it another way.
# DRIVE_PUBLIC_FILES=true
# Only for a personal My Drive via domain-wide delegation.
# GOOGLE_IMPERSONATE_SUBJECT=someone@10minuteschool.com

# Optional: override the 10MS OAuth verification host (defaults to the prod API).
# TENMS_AUTH_BASE_URL=https://api.10minuteschool.com/auth
# Optional: tune the Sheets API rate limiter (calls/minute, per instance).
# SHEETS_READS_PER_MINUTE=150
# SHEETS_WRITES_PER_MINUTE=150
