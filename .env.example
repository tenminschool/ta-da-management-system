PORT=3000

# PostgreSQL — every record lives here, in tables prefixed ta_da_.
# `npm run db:setup` creates them ahead of time; they are also created on first use.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Sessions are signed with a key derived from DATABASE_URL — nothing else to set.

# Login with 10 Minute School (public client ID — safe in the browser)
VITE_TENMS_CLIENT_ID=tenms_xxxxxxxxxxxxxxxx
# Optional: pin the OAuth redirect URI. Defaults to the current origin.
# VITE_TENMS_REDIRECT_URI=https://your-app.vercel.app

# Claim documents go to the 10MS file service, sent from the browser with the signed-in
# person's own 10MS token. These are the defaults; override only if they change.
# UPLOAD_BUCKET=10mscdn
# UPLOAD_ACL=public-read
# MAX_UPLOAD_MB=50

# ── Claim notification mails (10MS Postal) ─────────────────────────────────
# Mails are sent with the signed-in person's own 10MS token (Authorization: Bearer …); nothing to set for that.
# Defaults to the live Postal endpoint.
# POSTAL_MAIL_URL=https://postal.10minuteschool.com/api/v1/mail/send
# The From address on the mails.
# POSTAL_MAIL_FROM=peopleops@10minuteschool.com
# Link used in the mails; defaults to the address the request came in on.
# APP_URL=https://your-app.vercel.app

# ── Roles come from 10MS groups or permissions ─────────────────────────────
# A person's role is decided by the 10MS group they belong to. Defaults shown; change them if the
# group names differ.
# GROUP_ADMIN=ta_da_admin
# GROUP_HR=ta_da_hr
# GROUP_FINANCE=ta_da_finance
# ...or by holding the 10MS permission with the same meaning (either one is enough):
# PERMISSION_ADMIN=tada.role.admin
# PERMISSION_HR=tada.role.hr
# PERMISSION_FINANCE=tada.role.finance
# Desk emails (HR, admin, Finance) go to the members of those groups, read from the 10MS
# directory. These lists (comma-separated) add to that and stand in if the directory cannot be read.
# ADMIN_EMAILS=
# HR_EMAILS=
# FINANCE_EMAILS=
