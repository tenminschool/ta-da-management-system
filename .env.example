GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
SPREADSHEET_ID=your_spreadsheet_id
PORT=3000

# PostgreSQL — where every tab except Employees lives (tables are prefixed ta_da_).
# `npm run db:setup` creates them; `npm run db:migrate` copies the sheet's data across.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Login with 10 Minute School (public client ID — safe in the browser)
VITE_TENMS_CLIENT_ID=tenms_xxxxxxxxxxxxxxxx
# Optional: pin the OAuth redirect URI. Defaults to the current origin.
# VITE_TENMS_REDIRECT_URI=https://your-app.vercel.app

# Local development only. Never set this in production — SSO is the front door.
# ALLOW_PASSWORD_LOGIN=true

# Claim documents go to the 10MS file service, sent from the browser with the signed-in
# person's own 10MS token. These are the defaults; override only if they change.
# UPLOAD_BUCKET=10mscdn
# UPLOAD_ACL=public-read

